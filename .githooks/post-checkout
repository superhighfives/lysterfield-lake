#!/bin/sh
# Shares gitignored per-machine state across all worktrees: in a linked
# worktree, symlink each path below to the main checkout's copy.
# - apps/pipeline/.jobs: pipeline outputs, so the skip-if-output-exists checks
#   guarding Replicate calls aren't defeated by a fresh, empty copy.
# - apps/pipeline/.env: REPLICATE_API_TOKEN and friends.
# - apps/pipeline/resources/colours: the colour and style images /admin's
#   new-dream form offers (gitignored; uploads land here too).
# Runs automatically on `git worktree add`; safe to run by hand in an
# existing worktree.

top=$(git rev-parse --show-toplevel) || exit 0
common=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
main=$(dirname "$common")

[ "$(cd "$top" && pwd -P)" = "$main" ] && exit 0

share() {
  link="$top/$1"
  target="$main/$1"

  [ -L "$link" ] && return
  if [ -e "$link" ]; then
    echo "post-checkout: $link exists and isn't a symlink; leaving it alone" >&2
    return
  fi

  mkdir -p "$(dirname "$link")"
  ln -s "$target" "$link"
}

mkdir -p "$main/apps/pipeline/.jobs"
share apps/pipeline/.jobs

mkdir -p "$main/apps/pipeline/resources/colours"
share apps/pipeline/resources/colours

if [ -e "$main/apps/pipeline/.env" ]; then
  share apps/pipeline/.env
else
  echo "post-checkout: no apps/pipeline/.env in the main checkout to share" >&2
fi
