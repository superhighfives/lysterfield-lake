VITE_APP_URL=http://localhost:5173
# Visitors' polaroids (plans/in-progress/polaroids.md) are on in dev: /polaroids, /polaroids/add and /p/<id>,
# with the API from `wrangler dev` (proxied, vite.config.ts) and Turnstile's always-pass test site key.
VITE_APP_POLAROIDS=true
VITE_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# In dev, a finished polaroid's files come from its job on this machine (vite-plugin-admin.ts), not the bucket.
VITE_APP_POLAROIDS_URL=/__admin/visitor
