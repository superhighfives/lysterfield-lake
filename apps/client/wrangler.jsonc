// The app: a Worker serving the built site from dist/, with no script of its own. Deployed by
// .github/workflows/deploy.yml, or `bun run deploy` by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lysterfield-lake",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // The live site. It was the lysterfield-lake Pages project until 2026-10-23.
  "routes": [{ "pattern": "lysterfieldlake.com", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    // A missing page gets public/404.html, as on Pages.
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
